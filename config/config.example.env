# 🎯 ULTIMATE COLLECTOR - CONFIGURAÇÃO DE EXEMPLO
# Copie este arquivo para .env e configure suas credenciais

# ===========================================
# 🌐 CONFIGURAÇÕES DA API FACTORIAL
# ===========================================
# URL base da API Factorial
BASE_URL=https://api.eu2.demo.factorial.dev

# Token de autenticação (Bearer token ou API Key)
API_KEY=seu_token_aqui

# Versão oficial da API Factorial
API_VERSION=2026-07-01

# Tipo de autenticação (bearer, x-api-key, oauth2)
AUTH_TYPE=bearer

# ===========================================
# 📥 CONFIGURAÇÕES DE COLETA AUTOMÁTICA
# ===========================================
# Executar coleta automática ao iniciar (True/False)
AUTO_COLLECT_ON_START=True

# Categorias para coleta automática (separadas por vírgula)
AUTO_COLLECT_CATEGORIES=employees,finance,expenses

# Intervalo de coleta automática (em minutos)
AUTO_COLLECT_INTERVAL=60

# ===========================================
# 📤 CONFIGURAÇÕES DE ENVIO AUTOMÁTICO
# ===========================================
# Executar envio automático ao iniciar (True/False)
AUTO_SEND_ON_START=False

# Tipos de envio automático (separados por vírgula)
AUTO_SEND_TYPES=attendance,finance

# Intervalo de envio automático (em minutos)
AUTO_SEND_INTERVAL=30

# ===========================================
# 👥 CONFIGURAÇÕES DE PRESENÇA
# ===========================================
# IDs dos funcionários para presença automática (separados por vírgula)
AUTO_ATTENDANCE_EMPLOYEES=270105,270284

# Horário padrão de entrada
DEFAULT_CLOCK_IN_TIME=08:00

# Horário padrão de saída
DEFAULT_CLOCK_OUT_TIME=17:00

# Incluir localização nas batidas (True/False)
INCLUDE_LOCATION=True

# Latitude padrão (São Paulo)
DEFAULT_LATITUDE=-23.5505

# Longitude padrão (São Paulo)
DEFAULT_LONGITUDE=-46.6333

# ===========================================
# 🔄 CONFIGURAÇÕES DE TURNOS
# ===========================================
# Gerar turnos automaticamente (True/False)
AUTO_GENERATE_SHIFTS=False

# IDs dos funcionários para turnos automáticos (separados por vírgula)
AUTO_SHIFT_EMPLOYEES=270105,270284

# Dias para geração de turnos
SHIFT_GENERATION_DAYS=30

# Horário de início do turno
SHIFT_START_TIME=08:00

# Horário de fim do turno
SHIFT_END_TIME=17:00

# Horário de início do intervalo
SHIFT_BREAK_START=12:00

# Horário de fim do intervalo
SHIFT_BREAK_END=13:00

# ===========================================
# 💰 CONFIGURAÇÕES FINANCEIRAS
# ===========================================
# Executar coleta financeira automática (True/False)
AUTO_FINANCE_COLLECT=True

# Executar envio financeiro automático (True/False)
AUTO_FINANCE_SEND=False

# Categorias financeiras para coleta (separadas por vírgula)
AUTO_FINANCE_CATEGORIES=accounts,accounting_settings,categories,contacts,cost_centers,financial_documents,journal_entries,tax_rates,tax_types

# Intervalo de coleta financeira (em minutos)
AUTO_FINANCE_COLLECT_INTERVAL=120

# Intervalo de envio financeiro (em minutos)
AUTO_FINANCE_SEND_INTERVAL=60

# ===========================================
# 🏦 CONFIGURAÇÕES CONTÁBEIS
# ===========================================
# Criar contas contábeis automaticamente (True/False)
AUTO_CREATE_ACCOUNTS=False

# Criar centros de custo automaticamente (True/False)
AUTO_CREATE_COST_CENTERS=False

# Criar categorias financeiras automaticamente (True/False)
AUTO_CREATE_CATEGORIES=False

# Criar contatos financeiros automaticamente (True/False)
AUTO_CREATE_CONTACTS=False

# ===========================================
# 📊 CONFIGURAÇÕES DE LANÇAMENTOS CONTÁBEIS
# ===========================================
# Criar lançamentos contábeis automaticamente (True/False)
AUTO_CREATE_JOURNAL_ENTRIES=False

# Número máximo de lançamentos por lote
MAX_JOURNAL_ENTRIES_PER_BATCH=50

# Conta padrão para débito
DEFAULT_DEBIT_ACCOUNT=1001

# Conta padrão para crédito
DEFAULT_CREDIT_ACCOUNT=2001

# ===========================================
# 📈 CONFIGURAÇÕES DE IMPOSTOS
# ===========================================
# Criar alíquotas de imposto automaticamente (True/False)
AUTO_CREATE_TAX_RATES=False

# Criar tipos de imposto automaticamente (True/False)
AUTO_CREATE_TAX_TYPES=False

# Alíquota padrão de ICMS (%)
DEFAULT_ICMS_RATE=18.0

# Alíquota padrão de IPI (%)
DEFAULT_IPI_RATE=10.0

# Alíquota padrão de PIS (%)
DEFAULT_PIS_RATE=1.65

# Alíquota padrão de COFINS (%)
DEFAULT_COFINS_RATE=7.6

# ===========================================
# 📧 CONFIGURAÇÕES DE EMAIL (OPCIONAL)
# ===========================================
# Enviar notificações por email (True/False)
EMAIL_NOTIFICATIONS=False

# Servidor SMTP
EMAIL_SMTP_SERVER=smtp.gmail.com

# Porta SMTP
EMAIL_SMTP_PORT=587

# Usuário do email
EMAIL_USERNAME=seu_email@gmail.com

# Senha do email
EMAIL_PASSWORD=sua_senha

# Email de destino
EMAIL_TO=destino@gmail.com
