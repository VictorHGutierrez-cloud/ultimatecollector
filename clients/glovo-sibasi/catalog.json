  "posts": [
    {
      "title": "Welcome to Kibanda on Factorial",
      "description": "Team, we have one home for every employee: contracts, leave, rotas and payslips. Brenda's Sundays are coming back — start in the Factorial app, not in WhatsApp.",
      "allow_comments_and_reactions": true,
      "cover_image": "announcements/01_welcome_kibanda.jpg"
    },
    {
      "title": "Rotas live in the app — not WhatsApp",
      "description": "Branch managers: publish next week's rota from Factorial. Staff get shifts on their phone and swap requests go to the manager for approval. One rest day in every seven — Factorial will flag a seventh straight day.",
      "allow_comments_and_reactions": true,
      "cover_image": "announcements/02_rotas_app.jpg"
    },
    {
      "title": "Mashujaa Day — double pay for anyone who works",
      "description": "On Mashujaa Day (20 October), anyone scheduled to work is marked for double pay automatically. Check your rota in the app and talk to your branch manager if you need a swap.",
      "allow_comments_and_reactions": true,
      "cover_image": "announcements/03_mashujaa_day.jpg"
    },
    {
      "title": "Hiring for the December rush",
      "description": "We are opening fixed-term waiter roles, a cook role and a barista role for December. Branch managers: score candidates in Factorial so offers and onboarding start without retyping details.",
      "allow_comments_and_reactions": true,
      "cover_image": "announcements/04_december_hiring.jpg"
    },
    {
      "title": "Minimum wage check — May 2026 rates",
      "description": "Kenya raised minimum wages in May 2026. Kibanda salaries are checked against the Nairobi floor (waiters/cooks from KES 19,491 basic). Esther and Samuel review pre-payroll before the 9th every month.",
      "allow_comments_and_reactions": true,
      "cover_image": "announcements/05_minimum_wage.jpg"
    }
  ],
